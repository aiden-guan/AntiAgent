{
  "antiagent-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m antiagent.hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "antiagent-flow-state": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 -m antiagent.flow_hook pre-invocation",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 -m antiagent.flow_hook stop",
        "timeout": 10
      }
    ]
  }
}
